# Supabase - CONFIGURE ESTAS VARIÁVEIS COM SEUS DADOS REAIS
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Database (Prisma) - CONFIGURE COM SEUS DADOS REAIS
DATABASE_URL=postgresql://postgres:[senha]@db.[projeto].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[senha]@db.[projeto].supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# JWT - CONFIGURE COM SEUS DADOS REAIS
JWT_SECRET=seu-jwt-secret-aqui
JWT_REFRESH_SECRET=seu-jwt-refresh-secret-aqui

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Monitoring
SENTRY_DSN=seu-sentry-dsn-aqui
